# Worker image: runs BullMQ analyze worker (tsx for TypeScript)
FROM node:20-alpine AS base
WORKDIR /app
COPY package.json package-lock.json ./

# Reduce ECONNRESET / network flakes in CI (Jenkins, etc.)
RUN npm config set fetch-timeout 120000 && \
    npm config set fetch-retries 5 && \
    npm config set fetch-retry-mintimeout 20000 && \
    npm config set fetch-retry-maxtimeout 120000

ARG HTTP_PROXY
ARG HTTPS_PROXY
ENV HTTP_PROXY=${HTTP_PROXY} HTTPS_PROXY=${HTTPS_PROXY}

# Install all deps including devDependencies (tsx) for running worker
ENV NODE_ENV=development
RUN npm ci --legacy-peer-deps || \
    (sleep 20 && npm ci --legacy-peer-deps) || \
    (sleep 45 && npm ci --legacy-peer-deps)
ENV NODE_ENV=production
COPY . .

# Worker loads env from .env at runtime (mounted or injected)
CMD ["npx", "tsx", "lib/workers/analyze-worker.ts"]
